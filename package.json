{
  "name": "@kevinwatt/yt-dlp-mcp",
  "version": "0.6.26",
  "description": "An MCP server implementation that integrates with yt-dlp, providing video and audio content download capabilities (e.g. YouTube, Facebook, Tiktok, etc.) for LLMs.",
  "keywords": [
    "mcp",
    "youtube",
    "yt-dlp",
    "dive",
    "llm"
  ],
  "homepage": "https://github.com/kevinwatt/yt-dlp-mcp#readme",
  "bugs": {
    "url": "https://github.com/kevinwatt/yt-dlp-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinwatt/yt-dlp-mcp.git"
  },
  "bin": {
    "yt-dlp-mcp": "lib/index.mjs"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "main": "./lib/index.mjs",
  "scripts": {
    "build": "tsc && shx chmod +x ./lib/index.mjs",
    "start": "node lib/index.mjs",
    "test": "PYTHONPATH= PYTHONHOME= node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "author": "Dewei Yen <k@funmula.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./lib/index.mjs"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.806.0",
    "@aws-sdk/s3-request-presigner": "^3.806.0",
    "@modelcontextprotocol/sdk": "0.7.0",
    "@wizdy/blaxel_core": "^0.2.1-dev4-1",
    "@wizdy/typescript-sdk": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.43.1",
    "rimraf": "^6.0.1",
    "spawn-rx": "^4.0.0",
    "string-argv": "^0.3.2",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/string-argv": "^0.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@types/yargs-parser": "^21.0.3",
    "jest": "^29.7.0",
    "shx": "^0.3.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.2"
  }
}
